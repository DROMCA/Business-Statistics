# Ignore everything outside GBU 2301.
/*

# Keep the ignore rules and allow traversal into GBU 2301.
!/.gitignore
!/readme.txt
!/install.ipynb
!/requirements.txt
!/GBU 2301/

# Ignore everything under GBU 2301 by default.
/GBU 2301/*

# Keep only the listed syllabus and schedule files.
# !/GBU 2301/syllabus_schedule/
# /GBU 2301/syllabus_schedule/*
# !/GBU 2301/syllabus_schedule/Syllabus  GBU 2301  Fall 2026 - DrOC.pdf
# !/GBU 2301/syllabus_schedule/Syllabus  GBU 2301  Spring 2026 - DrOC.docx

# Lecture files are ignored by default.
!/GBU 2301/lectures/
/GBU 2301/lectures/**
!/GBU 2301/lectures/**/

# Lecture inventory
# Remove the leading # only after a lecture file is finalized.
# !/GBU 2301/lectures/week_01/w01_course_intro_and_data.ipynb
# !/GBU 2301/lectures/week_01/w01_course_intro_and_data_ws.ipynb
# !/GBU 2301/lectures/week_02/w02_tabular_and_graphical_displays.ipynb
# !/GBU 2301/lectures/week_02/w02_tabular_and_graphical_displays_ws.ipynb
# !/GBU 2301/lectures/week_03/w03_numerical_measures_ws.ipynb

# Always ignore foundations and examination folders.
/GBU 2301/foundations/
/GBU 2301/midterm_exam/
/GBU 2301/final_exam/
